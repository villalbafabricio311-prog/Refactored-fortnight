local function makeToggle(label, default, cb)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundTransparency = 1,
    }, Content)

    new("TextLabel", {
        Size = UDim2.new(1, -44, 1, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = label,
        TextSize = 13,
        TextColor3 = COL.TEXT,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local btn = new("TextButton", {
        Size = UDim2.new(0, 38, 0, 20),
        Position = UDim2.new(1, -38, 0.5, -10),
        BackgroundColor3 = COL.OFF,
        Text = "",
        AutoButtonColor = false,
        BorderSizePixel = 0,
    }, row)
    new("UICorner", { CornerRadius = UDim.new(1, 0) }, btn)

    local knob = new("Frame", {
        Size = UDim2.new(0, 16, 0, 16),
        Position = UDim2.new(0, 2, 0.5, -8),
        BackgroundColor3 = Color3.fromRGB(232, 234, 240),
        BorderSizePixel = 0,
    }, btn)
    new("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)

    local state = default
    local function render()
        TweenService:Create(btn, TweenInfo.new(0.15),
            { BackgroundColor3 = state and COL.ACCENT or COL.OFF }):Play()
        TweenService:Create(knob, TweenInfo.new(0.15),
            { Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8) }):Play()
    end
    render()

    btn.MouseButton1Click:Connect(function()
        state = not state
        render()
        cb(state)
    end)
end

local function makeSlider(label, min, max, default, cb)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundTransparency = 1,
    }, Content)

    new("TextLabel", {
        Size = UDim2.new(1, -44, 0, 16),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = label,
        TextSize = 12,
        TextColor3 = COL.TEXT,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local val = new("TextLabel", {
        Size = UDim2.new(0, 44, 0, 16),
        Position = UDim2.new(1, -44, 0, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = tostring(default),
        TextSize = 12,
        TextColor3 = COL.ACCENT,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, row)

    local track = new("Frame", {
        Size = UDim2.new(1, 0, 0, 6),
        Position = UDim2.new(0, 0, 0, 22),
        BackgroundColor3 = COL.OFF,
        BorderSizePixel = 0,
    }, row)
    new("UICorner", { CornerRadius = UDim.new(1, 0) }, track)

    local ratio = (default - min) / (max - min)

    local fill = new("Frame", {
        Size = UDim2.new(ratio, 0, 1, 0),
        BackgroundColor3 = COL.ACCENT,
        BorderSizePixel = 0,
    }, track)
    new("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)

    local knob = new("Frame", {
        Size = UDim2.new(0, 12, 0, 12),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(ratio, 0, 0.5, 0),
        BackgroundColor3 = Color3.fromRGB(240, 242, 248),
        BorderSizePixel = 0,
        ZIndex = 2,
    }, track)
    new("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)

    local hit = new("Frame", {
        Size = UDim2.new(1, 0, 0, 24),
        Position = UDim2.new(0, 0, 0, 13),
        BackgroundTransparency = 1,
        ZIndex = 3,
    }, row)

    local dragging = false

    local function setFromX(x)
        local rel = clamp((x - hit.AbsolutePosition.X) / hit.AbsoluteSize.X, 0, 1)
        local v = math.floor(min + (max - min) * rel + 0.5)
        val.Text = tostring(v)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        cb(v)
    end

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            setFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end
